---
import { getCollection } from 'astro:content';

interface Props {
	locale?: 'en' | 'tr';
}

const { locale = 'en' } = Astro.props;
const isTurkish = locale === 'tr';

const categoryDescriptions = {
	'Clarify & Collaborate': 'Make unclear work discussable, teachable, and transferable.',
	'Discover & Design': 'Turn uncertainty into decisions, specifications, and coherent designs.',
	'Build & Verify': 'Implement, test, diagnose, review, and improve code with evidence.',
	'Ship & Operate': 'Release changes safely and keep running systems understandable.',
	'Extend Doctrine': 'Write agent-facing instructions that preserve Doctrine\'s boundaries.',
};

const turkishCategories = {
	'Clarify & Collaborate': {
		label: 'Netleştir ve Birlikte Çalış',
		description: 'Belirsiz bir işi konuşulabilir, öğrenilebilir ve başkasına devredilebilir hâle getirin.',
	},
	'Discover & Design': {
		label: 'Keşfet ve Tasarla',
		description: 'Belirsizliği somut kararlara, açık tanımlara ve tutarlı tasarımlara dönüştürün.',
	},
	'Build & Verify': {
		label: 'Geliştir ve Doğrula',
		description: 'Kodu geliştirin, test edin, sorunları teşhis edin ve sonucu kanıta dayanarak doğrulayın.',
	},
	'Ship & Operate': {
		label: 'Yayınla ve Sürdür',
		description: 'Değişiklikleri güvenle yayına alın ve çalışan sistemde neler olduğunu görebilin.',
	},
	'Extend Doctrine': {
		label: "Doctrine'ı Genişlet",
		description: "Doctrine'ın sınırlarını koruyan, ajanların uygulayabileceği talimatlar yazın.",
	},
} as const;

const turkishSkillDescriptions = {
	'api-design-standards': 'Kaynak adları, URL yapısı, sürümleme, geriye uyumluluk ve sözleşme testleri için ortak API kuralları getirir. Yeni bir API uç noktası (endpoint) tasarlarken veya mevcut bir API sözleşmesini değiştirirken kullanın.',
	'architecture-diagram': 'Bir sistemin mimarisini, ihtiyaca uygun ayrıntı düzeyinde kodla üretilen bir diyagrama dönüştürür. Bileşenleri, veri akışını veya bir karar yolunu görünür kılmanız gerektiğinde kullanın.',
	'capacity-estimation': 'Belirsiz bir performans beklentisini, mimari seçilmeden önce sayıya çevirir; Little Yasası ile gereken eşzamanlılığı hesaplar ve her girdiyi ölçülmüş, türetilmiş ya da varsayılmış olarak etiketler. Bir tasarım hiç sayı vermeden “hızlı” veya “ölçeklenebilir” diyorsa, ya da havuz, kuyruk ve sunucu sayısı belirlenecekse kullanın.',
	'code-review': 'Kod incelemesini kişisel zevklerden çıkarıp somut kod kokularına, kod sağlığına ve küçük PR’lara dayandırır. Bir pull request ya da diff’i incelerken ve geri bildirim verirken kullanın.',
	'code-style-lint': 'Biçimlendirmeyi ekosistemin standart aracıyla otomatikleştirir; görünümü düzenleyen formatter ile gerçek kusurları bulan linter’ı birbirinden ayırır. Projenin araçlarını kurarken veya stil tartışmalarını CI’a bırakmak istediğinizde kullanın.',
	'codebase-design': 'Basit bir arayüzün arkasında güçlü işlev sunan derin modüller tasarlar ve iç ayrıntıları modül içinde saklar. Modül sınırı çizerken, sınıfları bölüp birleştirirken veya karmaşıklığın kaynağını ararken kullanın.',
	'dependency-upgrade-management': 'Bağımlılıkları envanterle takip eder, güvenlik güncellemelerine öncelik verir ve kullanım sonlandırma takvimini açıkça belirler. Dependabot ya da Renovate PR’larını değerlendirirken veya bir özelliği kaldırmaya hazırlanırken kullanın.',
	'diagnosing-bugs': 'Önce sistemi anlamayı ve hatayı güvenilir biçimde yeniden üretmeyi, sonra olası nedenleri daraltıp düzeltmeyi aynı hata üzerinde doğrulamayı sağlar. Bir şey bozulduğunda, yanlış çalıştığında veya yavaşladığında kullanın.',
	'domain-modeling': 'Kodda ve konuşmalarda kullanılacak ortak dili kurar; bounded context denilen iş alanı sınırlarını ve önemli kararlar için mimari karar kayıtlarını (ADR) netleştirir. Terimler tutarsızsa veya aynı kelime farklı alanlarda farklı anlamlara geliyorsa kullanın.',
	'explain-plainly': 'Teknik bir konuyu, teknik geçmişi olmayan okurun anlayacağı sade dille anlatır ve kullanılması şart olan terimleri geçtiği yerde açıklar. Teknik ekip dışındaki birine açıklama yaparken kullanın.',
	'grilling': 'Bir plan, karar veya fikirde saklı kalan bilinmeyenleri birkaç tur yoğun soruyla ortaya çıkarır. Varsayımlar görünmüyorsa veya önemli kararlar verilmeden uygulamaya geçiliyorsa kullanın.',
	'handoff': 'Devam eden işi, nöbeti veya olayı dört bölümlü sabit bir özetle başka bir kişiye ya da ajana devreder. Sorumluluk el değiştirirken önemli bağlamın kaybolmasını önlemek için kullanın.',
	'improve-codebase-architecture': 'Kod tabanında geliştirmeyi zorlaştıran mimari sorunları sınıflandırır ve getirisi en yüksek iyileştirmeleri öne çıkarır. Mimari inceleme yaparken, teknik borcu sıralarken veya sıradaki refactor’a karar verirken kullanın.',
	'incident-response': 'Üretim olayının önemini belirlemekten rolleri dağıtmaya, önce etkiyi azaltmaktan suçlayıcı olmayan olay sonrası değerlendirme (postmortem) yazmaya kadar tüm süreci yönetir. Olay sırasında veya hemen sonrasında kullanın.',
	'observability': 'Yapılandırılmış loglar, dört altın sinyal, servis göstergeleri ve hedefleriyle (SLI/SLO) sistemin sağlığını kodu okumadan anlayabilmenizi sağlar. İzleme ve alarm sistemi kurarken ya da üretimde sorun ararken kullanın.',
	'project-groundwork': 'Taslak tanımda veya README’de uygulamayı engelleyen boşlukları tek soru turunda kapatır ve alınan kararları ana belgeye işler. Koda başlamadan önce çelişkileri ve henüz belirlenmemiş noktaları çözmek için kullanın.',
	'prototype': 'Bir yaklaşıma bağlanmadan önce tek bir teknik ya da tasarım sorusunu yanıtlayan, gerektiğinde atılabilecek küçük bir deneme üretir. Durum modelinin, mantığın veya arayüz yönünün çalışıp çalışmayacağını sınarken kullanın.',
	'release-versioning': 'Conventional Commits ile değişikliğin türünü, SemVer ile yeni sürüm numarasını belirler ve değişiklik günlüğünü hazırlar. Sürüm çıkarırken veya major, minor, patch kararını verirken kullanın.',
	'repo-secure': 'Bir GitHub deposunun mevcut güvenlik ayarlarını denetler ve depo sorumlusunun onayıyla eksikleri etkinleştirir. Secret scanning, branch protection veya `SECURITY.md` gerektiğinde kullanın.',
	'repo-ship': 'Tamamlanan işi amacına göre ayrı commit’lere böler; yeni depolara doğru ad, görünürlük, açıklama ve konu etiketlerini verir. Commit ya da push öncesinde veya yeni depo açarken kullanın.',
	'research': 'Teknik bir soruyu birincil kaynaklardan araştırır ve kaynak gösterilen bulguları depodaki bir dosyaya kaydeder. Bir iddiayı doğrulamanız veya teknik belgeleri karşılaştırmanız gerektiğinde kullanın.',
	'resolving-merge-conflicts': 'Merge veya rebase çatışmasında iki tarafın da ne amaçladığını ortak ataya kadar izler ve buna göre birleştirir. Git çatışma işaretleriyle karşılaştığınızda, taraflardan birini doğrudan seçmek yerine kullanın.',
	'safe-deployment': 'Deploy ile release arasındaki farkı korur, değişikliği kademeli olarak yayar ve otomatik geri alma koşulunu baştan belirler. Riskli bir değişikliği özellik bayrağı (feature flag), kontrollü pilot yayın (canary) veya benzeri yöntemlerle yayına alırken kullanın.',
	'secure-coding': 'OWASP Top 10’u temel alarak güvenliği kod yazılırken uygular; girdi doğrulama, erişim kontrolü, sırlar, bağımlılıklar ve güvenli hata yönetimini kapsar. Kod bir güven sınırından veri alıyor ya da geçiriyorsa kullanın.',
	'spec-to-tickets': 'Üzerinde anlaşılmış planı yazılı bir tanıma ve baştan sona çalışan küçük işlere dönüştürür; işe başlama koşullarını Definition of Ready, bitiş koşullarını Definition of Done ile belirler. Planı uygulanabilir işlere bölüp sıralarken kullanın.',
	'tdd': 'Geliştirmeyi başarısız test, çalışan kod ve düzenleme adımlarından oluşan red, green, refactor döngüsüyle başlatır; test piramidi ve FIRST ilkelerini uygular. Bir özellik veya hata düzeltmesini test yazarak geliştirmek istediğinizde kullanın.',
	'teach': 'Bir kavramı okurun bilgi düzeyine uygun biçimde anlatır ve tam örnekten bağımsız uygulamaya geçerken desteği adım adım azaltır. Bilginin yalnızca aktarılması değil, gerçekten öğrenilmesi gerektiğinde kullanın.',
	'test-strategy': 'Test verisinin nereden geleceği, kararsız testlerin nasıl ele alınacağı ve integration ile e2e sınırı gibi bütün test paketini etkileyen kararları verir. Bir bileşen sınırında unit, contract, integration veya e2e testi seçerken kullanın.',
	'to-questionnaire': 'Tek başınıza veremeyeceğiniz bir karar için, eksik bilgiyi bilen kişiye yöneltilecek açık ve yazılı sorular hazırlar. Bilgiyi eşzamansız olarak ya da yapılandırılmış bir görüşmeyle toplamanız gerektiğinde kullanın.',
	'triage': 'Gelen hata veya özellik talebini Etki × Aciliyet ölçütüyle sınıflandırır, önceliklendirir ve doğru sonraki adıma yönlendirir. Backlog’u düzenlerken veya issue önceliğine karar verirken kullanın.',
	'wait-what': 'Son açıklamanın anlaşılmadığını fark eder ve aynı cümleleri tekrarlamak yerine konuyu başka bir düzeyde yeniden anlatır. Kullanıcının yanıtı kafa karışıklığına işaret ediyorsa kullanın.',
	'wayfinder': 'Tek oturuma sığmayacak kadar büyük veya belirsiz bir işi, sırayla çözülecek yazılı karar aşamalarına böler. Kabaca tarif edilmiş bir fikri uygulamadan önce izlenebilir bir yola çevirmek için kullanın.',
	'wizard': 'Yalnızca insanın tamamlayabileceği elle yapılan bir işlemi adım adım yöneten etkileşimli bir script üretir. Kimlik bilgisi, CI sırrı, üçüncü taraf paneli veya tek seferlik geçiş gerektiren işlerde kullanın.',
	'writing-for-agents': 'Ajanın okuyacağı skill, `AGENTS.md`, `CLAUDE.md` veya bağlantılı belgelerde prosedürü, olguyu ve gerekçeyi birbirine karıştırmadan düzenler. Ajan talimatı yazarken ya da var olan talimatları elden geçirirken kullanın.',
} as const;

const categories = {
	'Clarify & Collaborate': [
		'explain-plainly',
		'teach',
		'wait-what',
		'grilling',
		'to-questionnaire',
		'wayfinder',
		'handoff',
		'triage',
		'wizard',
	],
	'Discover & Design': [
		'research',
		'project-groundwork',
		'prototype',
		'domain-modeling',
		'architecture-diagram',
		'capacity-estimation',
		'codebase-design',
		'api-design-standards',
		'spec-to-tickets',
	],
	'Build & Verify': [
		'tdd',
		'test-strategy',
		'code-style-lint',
		'secure-coding',
		'diagnosing-bugs',
		'code-review',
		'resolving-merge-conflicts',
		'improve-codebase-architecture',
	],
	'Ship & Operate': [
		'dependency-upgrade-management',
		'observability',
		'safe-deployment',
		'release-versioning',
		'repo-secure',
		'repo-ship',
		'incident-response',
	],
	'Extend Doctrine': ['writing-for-agents'],
};

const skills = await getCollection('skills');
const byName = new Map(skills.map((skill) => [skill.data.name, skill]));
const assigned = Object.values(categories).flat();
const duplicates = assigned.filter((name, index) => assigned.indexOf(name) !== index);
const missing = skills.map(({ data }) => data.name).filter((name) => !assigned.includes(name));
const unknown = assigned.filter((name) => !byName.has(name));
const translated = Object.keys(turkishSkillDescriptions);
const missingTranslations = skills
	.map(({ data }) => data.name)
	.filter((name) => !translated.includes(name));
const unknownTranslations = translated.filter((name) => !byName.has(name));

if (duplicates.length || missing.length || unknown.length || missingTranslations.length || unknownTranslations.length) {
	throw new Error(
		`Invalid skill catalog. Duplicate categories: ${duplicates.join(', ') || 'none'}. Missing categories: ${missing.join(', ') || 'none'}. Unknown categories: ${unknown.join(', ') || 'none'}. Missing Turkish translations: ${missingTranslations.join(', ') || 'none'}. Unknown Turkish translations: ${unknownTranslations.join(', ') || 'none'}.`,
	);
}
---

<p class="catalog-summary">
	<strong>{skills.length} {isTurkish ? 'skill' : 'skills'}</strong>{isTurkish
		? ', yapacağınız işe göre gruplandırıldı. Aradığınız durumu veya skill adını biliyorsanız aramayı kullanın.'
		: ', grouped by the work they help with. Search when you already know the situation or skill name.'}
</p>

{
	Object.entries(categories).map(([category, names]) => (
		<section aria-labelledby={`category-${category.toLowerCase().replaceAll(/[^a-z]+/g, '-')}`}>
			<h2 id={`category-${category.toLowerCase().replaceAll(/[^a-z]+/g, '-')}`}>
				{isTurkish
					? turkishCategories[category as keyof typeof turkishCategories].label
					: category}
			</h2>
			<p>
				{isTurkish
					? turkishCategories[category as keyof typeof turkishCategories].description
					: categoryDescriptions[category as keyof typeof categoryDescriptions]}
			</p>
			<div class="skill-grid">
				{names
					.map((name) => byName.get(name)!)
					.sort((a, b) => a.data.name.localeCompare(b.data.name))
					.map(({ data }) => (
						<article class="skill-card">
							<h3><code>{data.name}</code></h3>
							<p>
								{isTurkish
									? turkishSkillDescriptions[data.name as keyof typeof turkishSkillDescriptions]
									: data.description}
							</p>
							<a href={`https://github.com/aethrox/doctrine/blob/main/skills/${data.name}/SKILL.md`}>
								{isTurkish ? "SKILL.md'yi açın" : 'Open SKILL.md'} <span aria-hidden="true">↗</span>
							</a>
						</article>
					))}
			</div>
		</section>
	))
}

<style>
	.catalog-summary {
		padding: 0.9rem 1rem;
		border-left: 3px solid var(--sl-color-accent);
		background: var(--sl-color-accent-low);
	}
</style>
